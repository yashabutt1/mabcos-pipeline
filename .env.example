# Copy this file to ".env" and paste your keys. Never commit the real .env.

# Gemini powers the text copy. Get a key at https://aistudio.google.com
# (You can reuse the same key as your other pipeline.)
GEMINI_API_KEY=your_key_here

# Pexels powers the background photos + reel clips (free, generous limits).
# Get a key at https://www.pexels.com/api/  -> "Your API Key".
# If empty, cards fall back to locally-drawn gradient backgrounds (reels need it).
PEXELS_API_KEY=your_pexels_key_here

# Telegram approval bot — MABCOS NEEDS ITS OWN BOT (do not reuse the Love Lens
# bot token: two bots sharing one token will fight over getUpdates). Create one
# with @BotFather in ~1 min, then paste the token here. The CHAT ID can be the
# same as your other pipeline (messages just arrive from a different bot).
TELEGRAM_BOT_TOKEN=your_new_mabcos_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Facebook page posting.
#   FB_PAGE_TOKEN: a long-lived USER token whose app has been granted access to
#   the mabcos ("innovationthroughbiotech") page. If your existing user token's
#   app is also granted that page, you can reuse the SAME token here — the code
#   resolves the right Page token from /me/accounts using FB_PAGE_ID.
#   FB_PAGE_ID: the numeric ID of the mabcos page (NOT the Love Lens one).
FB_PAGE_TOKEN=your_user_or_page_token_here
FB_PAGE_ID=your_mabcos_page_id_here

# Amazon Associates (manual-link mode; no PA-API needed). Reuse your store tag.
AMAZON_ASSOC_TAG=your_store_tag-20
AMAZON_MARKETPLACE=www.amazon.com
# Optional: a Google Sheet published to web as CSV (columns: Name | Amazon URL).
# Lets you add products from any device; merged with products.txt.
GOOGLE_SHEET_CSV_URL=
