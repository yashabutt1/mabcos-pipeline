<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{--gold:#FFC62B;--gold2:#FFD66B;}
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{width:1080px;height:1920px;overflow:hidden;background:transparent}
  /* readability scrim — semi-transparent navy, heavy top/bottom, clear middle */
  /* light scrim: keeps the footage vivid, just enough darkening for the bars */
  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,
     rgba(8,14,38,.52) 0%, rgba(8,14,38,.16) 16%, rgba(8,14,38,.04) 40%,
     rgba(8,14,38,.10) 58%, rgba(8,14,38,.74) 100%)}
  .top{position:absolute;top:70px;left:64px;right:64px;display:flex;align-items:center;justify-content:space-between;z-index:2}
  .brand{display:flex;align-items:center;gap:16px}
  .logobadge{width:74px;height:74px;border-radius:17px;background:#fff;display:flex;align-items:center;justify-content:center;padding:9px;box-shadow:0 8px 22px rgba(0,0,0,.4)}
  .logobadge img{width:100%;height:100%;object-fit:contain}
  .wordmark{font-family:'Space Grotesk';font-weight:700;font-size:40px;letter-spacing:1px;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.6)}
  .wordmark span{color:var(--gold)}
  .pill{font-family:'Space Grotesk';font-weight:700;font-size:26px;letter-spacing:2px;color:#0a1230;
     background:linear-gradient(180deg,var(--gold2),var(--gold));padding:14px 28px;border-radius:999px;text-transform:uppercase}
  /* a soft rounded panel behind the hook so text stays crisp while the clip shows around it */
  .center{position:absolute;left:52px;right:52px;top:38%;transform:translateY(-42%);z-index:2;text-align:center;
     background:rgba(8,14,38,.46);border:1.5px solid rgba(255,255,255,.08);border-radius:40px;padding:52px 44px}
  .hook{font-family:'Space Grotesk';font-weight:700;font-size:{{ hook_size or 104 }}px;line-height:1.08;color:#fff;letter-spacing:-1px;text-shadow:0 3px 24px rgba(0,0,0,.55)}
  .hook .hl{color:var(--gold)}
  .sub{margin-top:34px;font-family:'Inter';font-weight:600;font-size:46px;line-height:1.35;color:#EAF0FF;text-shadow:0 2px 14px rgba(0,0,0,.6)}
  .foot{position:absolute;left:64px;right:64px;bottom:230px;z-index:2;text-align:center}
  .handle{font-family:'Space Grotesk';font-weight:600;font-size:40px;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.6)}
  .cta{margin-top:10px;font-family:'Inter';font-weight:600;font-size:32px;color:var(--gold);text-shadow:0 2px 10px rgba(0,0,0,.6)}
</style></head>
<body>
  <div class="scrim"></div>
  <div class="top">
    <div class="brand">
      {% if logo_uri %}<div class="logobadge"><img src="{{ logo_uri }}" alt=""></div>{% endif %}
      <div class="wordmark">MAB<span>COS</span></div>
    </div>
    {% if pill %}<div class="pill">{{ pill }}</div>{% endif %}
  </div>
  <div class="center">
    <div class="hook">{{ hook|safe }}</div>
    {% if sub %}<div class="sub">{{ sub|safe }}</div>{% endif %}
  </div>
  <div class="foot">
    <div class="handle">@innovationthroughbiotech</div>
    <div class="cta">Follow for daily biotech 🔬</div>
  </div>
</body></html>
